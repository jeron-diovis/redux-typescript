  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "stat": "vite preview --open stats.html",
    "analyze": "npm run build && npm run stat",
    "lint:js": "eslint src --ext .cjs,.js,.jsx,.ts,.tsx",
